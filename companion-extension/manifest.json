{
  "manifest_version": 3,
  "name": "StudyOS Learning Companion BETA",
  "version": "1.2.0",
  "version_name": "1.2.0 Private Beta",
  "description": "THIS EXTENSION IS FOR BETA TESTING. Automatically sync supported learning-video progress into your private StudyOS workspace.",
  "homepage_url": "https://studyos-web-production.up.railway.app/",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": [
    "https://studyos-web-production.up.railway.app/*",
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://*.pw.live/*",
    "https://*.physicswallah.live/*",
    "https://*.physicswallah.com/*",
    "https://*.pwskills.com/*",
    "https://*.diksha.gov.in/*",
    "https://*.khanacademy.org/*"
  ],
  "action": {
    "default_title": "StudyOS Learning Companion",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://studyos-web-production.up.railway.app/companion/connect*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtu.be/*",
        "https://*.pw.live/*",
        "https://*.physicswallah.live/*",
        "https://*.physicswallah.com/*",
        "https://*.pwskills.com/*",
        "https://*.diksha.gov.in/*",
        "https://*.khanacademy.org/*"
      ],
      "js": ["tracker.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
